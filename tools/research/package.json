{
  "name": "brimlo-research",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "research:cli": "tsx packages/cli/src/index.ts",
    "research:mcp": "tsx packages/mcp/src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "research:seed": "tsx packages/cli/src/index.ts competitors_seed",
    "research:api": "tsx packages/api/src/index.ts",
    "research:dev": "node scripts/dev.mjs",
    "research:demo": "tsx packages/mcp/src/demo.ts",
    "research:build": "pnpm --filter @brimlo/dashboard build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
